# ---- Server environment variables ----
# Copy into server/.env with real values (never commit secrets).

MONGODB_URI=
OPENAI_API_KEY=
JWT_SECRET=
PORT=5000
NODE_ENV=development

# Optional. If set, the frontend origin allowed by CORS in production.
CLIENT_URL=

# ---- Weather (Phase 12) ----
# Free key from https://openweathermap.org/api  (Current & Forecast > 5 day / 3 hour).
# Kept server-side so it isn't exposed in the browser. If unset, the weather
# widget simply hides itself.
OPENWEATHER_API_KEY=

# ---- Photos (Pexels) ----
# Free key from https://www.pexels.com/api/ — powers attractive destination/activity
# photos. Kept server-side. If unset, photos fall back to Wikipedia + curated images.
PEXELS_API_KEY=

# ---- Google Sign-In (Phase 16) ----
# The SAME OAuth 2.0 Client ID used on the client (…apps.googleusercontent.com).
# Used server-side to verify that Google ID tokens were issued for this app.
# You do NOT need the client secret for this flow.
GOOGLE_CLIENT_ID=
