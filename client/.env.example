# ---- Client environment variables (Vite) ----
# Copy the ones you need into client/.env  (never commit real values).
# Anything prefixed VITE_ is exposed to the browser bundle, so only put
# publishable / non-secret values here.

# Mapbox public token — used for maps, autocomplete, and geocoding.
VITE_MAPBOX_TOKEN=

# API base URL. Leave BLANK in local dev (the Vite proxy handles /api).
# In production set it to your Render backend, e.g. https://wanderwise-ai-backend.onrender.com
VITE_API_URL=

# ---- Cloudinary (image uploads on posts + profile pictures) ----
# Create a free account at https://cloudinary.com, then make an UNSIGNED upload
# preset (Settings > Upload > Upload presets). Both values are safe in the client.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---- Google Sign-In (OAuth) ----
# From Google Cloud Console > Credentials > OAuth 2.0 Client ID (Web application).
# This is the public Client ID (ends in .apps.googleusercontent.com), NOT the secret.
VITE_GOOGLE_CLIENT_ID=
